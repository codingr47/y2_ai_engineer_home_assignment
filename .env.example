EXTRACTOR_ENABLED=false
# Optional explicit mode overrides legacy EXTRACTOR_ENABLED/OPENAI_FALLBACK_ENABLED.
# PARSER_MODE=openai
EXTRACTOR_USE_TAGGER=true
CLASSIFIER_ARTIFACT_PATH=src/artifacts/classifier.joblib
E5_MODEL_PATH=models/multilingual-e5-small
CONFIDENCE_ARTIFACT_PATH=src/artifacts/confidence.joblib
# Optional override; changing the audited threshold invalidates its reliability claim.
# PARSE_CONFIDENCE_THRESHOLD=0.95
CACHE_MAX_SIZE=1024
# local parser when EXTRACTOR_ENABLED=true: frozen_fusion (default) or tagger (docs/tagger-parser.md)
LOCAL_PARSER=frozen_fusion
TAGGER_HYBRID_VEHICLE_TYPE=false

# Used on local-parser escalation. Enable EXTRACTOR_ENABLED too.
OPENAI_FALLBACK_ENABLED=false
# OPENAI_API_KEY=...
# OPENAI_MODEL=<your model ID>
# Optional: omit for the model default; unsupported efforts fail explicitly.
# OPENAI_REASONING_EFFORT=low
OPENAI_FEW_SHOT_COUNT=0
OPENAI_GUIDELINES_ENABLED=true
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=4096
